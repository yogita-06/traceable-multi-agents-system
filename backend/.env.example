# Groq free API key — get one at https://console.groq.com/keys
GROQ_API_KEY=#your_api_key_here

# Default model (free tier). Other good options: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# SQLite database file (created automatically on first run)
DATABASE_URL=sqlite:///./traceable.db

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# Fast demo mode — keeps a run under ~30s for live demos by capping live
# search to 2 queries with a 6s timeout each and failing over to the fallback
# source tiers immediately. Set to false for deeper (slower) research.
FAST_DEMO_MODE=true
