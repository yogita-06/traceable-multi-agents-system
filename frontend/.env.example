# Frontend environment variables (Vite).
#
# Only variables prefixed with VITE_ are exposed to the client bundle, and they
# are inlined at BUILD time (not runtime). Copy this file to `.env.local` for
# local overrides, or set the variable in the Render Static Site dashboard.

# Full base URL of the backend API, INCLUDING the /api prefix.
# Leave UNSET for local dev (the Vite proxy handles /api → http://localhost:8000).
# Set this in production (static hosting has no proxy):
VITE_API_BASE_URL=https://traceable-multi-agents-system.onrender.com/api
